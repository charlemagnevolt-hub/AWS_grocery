# Copy to terraform.tfvars and replace every placeholder.
# RDS manages the database password in Secrets Manager.
# app_revision must reference a pushed application commit.

allowed_ssh_cidr          = "YOUR.PUBLIC.IP.ADDRESS/32"
allowed_app_cidr          = "YOUR.PUBLIC.IP.ADDRESS/32"
s3_bucket_name            = "YOUR-GLOBALLY-UNIQUE-BUCKET-NAME"
final_snapshot_identifier = "grocerymate-final-CHANGE-ME"
app_revision             = "REPLACE_WITH_FULL_40_CHARACTER_COMMIT_SHA"
